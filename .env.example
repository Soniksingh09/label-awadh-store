# Frontend-safe Supabase values. Use the Project URL and publishable key only.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PUBLIC_KEY

# NEVER place service_role keys, database passwords, or payment secrets in VITE_ variables.
# Keep server-side secrets in Supabase Edge Function secrets only.
